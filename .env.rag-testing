# RAG Best Practices Testing Configuration
# Copy to .env to activate these settings

# Enable MMR for diversity in search results
RAG_USE_MMR=true

# Lower threshold for more permissive matching (0.0 = no filtering)
RAG_SCORE_THRESHOLD=0.3

# MMR Configuration (optional - defaults are already good)
RAG_MMR_K=4
RAG_MMR_FETCH_K=20
RAG_MMR_LAMBDA_MULT=0.5

# Future features (not yet implemented)
RAG_USE_HEADING_SPLITTER=false
RAG_ENABLE_DELETE=false
