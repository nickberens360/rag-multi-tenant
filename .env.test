# Test Environment Configuration
# This file contains environment variables specifically for E2E testing

# Environment settings
ENVIRONMENT=testing
ENV=testing
LOG_LEVEL=DEBUG

# Admin credentials for E2E tests
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123456789
ADMIN_TEST_USER_USERNAME=testuser
ADMIN_TEST_USER_PASSWORD=testuser123456789

# Database settings for testing
ADMIN_DB_PATH=backend/logs/admin_monitoring.db
ALLOW_DB_RESET=true

# Test-specific settings
ENABLE_CACHING=false
REQUEST_TIMEOUT=10
RATE_LIMIT=1000/minute

# Use fast models for testing
PRIMARY_LLM=claude
CLAUDE_MODEL=claude-3-haiku-20240307
GEMINI_MODEL=gemini-1.5-flash

# Reduced timeouts for faster tests
FOLLOWUP_MODE=static
ENABLE_FOLLOWUP_PREGENERATION=false
FOLLOWUP_USE_LLM_ENHANCEMENT=false