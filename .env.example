# Multi-Tenant RAG — Minimal Environment Configuration
# ========================================================
# Most configuration is managed in the Admin dashboard. Keep only
# secrets and deployment-specific values in this file.

# =====================================
# Environment & Public URLs
# =====================================
ENVIRONMENT=development
PUBLIC_API_URL=http://localhost:8000
PUBLIC_GITHUB_USERNAME=your_github_username
PUBLIC_GITHUB_REPO=your_repo_name
PUBLIC_GA_TRACKING_ID=

# =====================================
# Multi-Tenant Frontend Configuration
# =====================================
# Default tenant slug for root redirects (e.g., "nickberens", "acme")
PUBLIC_TENANT_DEFAULT_SLUG=nickberens

# Enable tenant validation in middleware (requires database lookup)
ENABLE_TENANT_VALIDATION=false

# =====================================
# Required Secrets (set in production)
# =====================================
# Generate secure values with:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
API_KEY_ENCRYPTION_SECRET=
IP_HASH_SALT=

# =====================================
# Admin Bootstrap (first run only)
# =====================================
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=change_me_immediately

# =====================================
# CORS
# =====================================
# Comma-separated list; production domains only in prod.
CORS_ORIGINS=http://localhost:4321,http://localhost:8000

# =====================================
# Persistence & Database
# =====================================
# Chroma vector store location (use a persistent path in production)
UNIFIED_PERSIST_DIR=backend/.unified_chroma
SQLITE_JOURNAL_MODE=WAL

# Multi-tenant database configuration
DATABASE_URL=postgresql://app_user:secure_password@localhost:5432/app_db
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
DEFAULT_TENANT_SLUG=default
SQL_ECHO=false

# Redis (for caching tenant lookups)
REDIS_URL=redis://localhost:6379/0

# Session configuration
SESSION_SECRET_KEY=generate-with-secrets-token-hex-32
SESSION_COOKIE_DOMAIN=.yourapp.com
SESSION_COOKIE_SECURE=true

# Multi-tenant feature flags
ENABLE_MULTI_TENANT=true
ENABLE_RLS_ENFORCEMENT=true
TENANT_RESOLUTION_MODE=subdomain_then_path
# Disable path-prefixed router mounts unless all routes accept tenant as a Path param
ENABLE_PATH_PREFIX_ROUTERS=false

# =====================================
# Caching & Timeouts
# =====================================
ENABLE_CACHING=true
CACHE_TTL=3600
REQUEST_TIMEOUT=60
CONTENT_CLASSIFICATION_MODE=fast

# =====================================
# Admin DB Tuning
# =====================================
ADMIN_DB_AUDIT_TIMEOUT_SECONDS=0.05
ADMIN_DB_BUSY_TIMEOUT_MS=15000
ADMIN_DB_CONNECT_RETRIES=7
ADMIN_DB_CONNECT_RETRY_DELAY_MS=300
ADMIN_DB_TIMEOUT_SECONDS=15
ADMIN_DB_WRITE_RETRIES=3
ADMIN_DB_WRITE_RETRY_DELAY_MS=50

# =====================================
# Notes
# =====================================
# - Do NOT put real secrets in source control. Use this file as an example.
# - In production, set these as deployment environment variables.
# - Manage LLM models, RAG, search, and feature flags in the Admin UI.
