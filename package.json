{
  "name": "rag-multi-tenant",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest",
    "test:run": "vitest run",
    "backend:build": "./scripts/copy-content-to-knowledge.sh && podman build -t rag-multi-tenant:latest -f Dockerfile .",
    "backend:dev": "podman run --rm --name rag-backend --network rag-multi-tenant-network -p 8001:8000 -v $(pwd)/backend:/app/backend:Z -v $(pwd)/backend/logs:/data:Z -v $(pwd)/public:/app/public:Z -v $(pwd)/admin:/app/admin:Z --env-file .env rag-multi-tenant:latest uvicorn backend.main:app --host 0.0.0.0 --port 8000",
    "backend:restart": "npm run backend:stop && npm run backend:dev",
    "backend:logs": "podman logs -f rag-backend",
    "backend:dev:reindex": "podman run --rm --name rag-backend -p 8001:8000 -v $(pwd)/backend:/app/backend:Z -v $(pwd)/backend/logs:/data:Z -v $(pwd)/public:/app/public:Z -e WATCHFILES_FORCE_POLLING=true -e FORCE_REBUILD_DATA=true --env-file .env rag-multi-tenant:latest uvicorn backend.main:app --host 0.0.0.0 --port 8000 --reload --reload-dir /app/backend",
    "backend:stop": "podman stop rag-backend || true",
    "admin:backend": "python3 admin/start-admin.py",
    "admin:frontend": "cd admin/frontend && npm run dev",
    "admin:build": "cd admin/frontend && NODE_ENV=production npm run build",
    "admin": "npm run admin:frontend",
    "admin:stop": "pkill -f 'python3 admin/start-admin.py' || true",
    "admin:sync": "python3 admin/sync_logs.py",
    "db:verify": "PYTHONPATH=. python3 scripts/verify-database-migration.py --verbose",
    "e2e": "cd tests/e2e && npx -y @playwright/mcp@latest test",
    "e2e:headed": "cd tests/e2e && npx -y @playwright/mcp@latest test --headed",
    "e2e:debug": "cd tests/e2e && npx -y @playwright/mcp@latest test --debug",
    "e2e:ui": "cd tests/e2e && npx -y @playwright/mcp@latest test --ui",
    "e2e:report": "cd tests/e2e && npx -y @playwright/mcp@latest show-report",
    "e2e:install": "cd tests/e2e && npx -y @playwright/mcp@latest install",
    "railway:build": "./scripts/copy-content-to-knowledge.sh && cd admin/frontend && npm ci && NODE_ENV=production npm run build",
    "railway:deploy": "railway up",
    "db:setup": "bash scripts/setup_db_podman.sh",
    "db:setup:seed": "bash scripts/setup_db_podman.sh --seed"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.0",
    "@astrojs/vue": "^5.1.0",
    "@fontsource-variable/doto": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.6",
    "@fontsource-variable/roboto-flex": "^5.2.6",
    "@fontsource/doto": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "@iconify-json/fa-brands": "^1.2.1",
    "@nanostores/vue": "^1.0.1",
    "astro": "^5.11.0",
    "astro-icon": "^1.1.5",
    "lodash-es": "^4.17.21",
    "marked": "^16.1.1",
    "nanostores": "^1.0.1"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
