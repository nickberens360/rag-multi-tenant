# Admin Frontend Configuration

# Backend API base URL
# Development: http://localhost:8000/api/admin (frontend respects this in dev)
# Production: /api/admin (served behind the same origin reverse proxy)
VITE_API_BASE_URL=http://localhost:8000/api/admin

# Base URL for the frontend application
# This should match the path where your admin frontend is served
# For development: /
# For production behind reverse proxy: /admin/
VITE_BASE_URL=/
