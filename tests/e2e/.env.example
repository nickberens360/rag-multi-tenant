# Admin E2E Test Environment Variables

# Admin Authentication
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123456789

# Service URLs
VITE_API_BASE_URL=http://localhost:8000/admin

# Test Configuration
NODE_ENV=test
CI=false
ARCHIVE_RESULTS=false
MOBILE_TESTS=false
DEBUG=false

# Performance Test Thresholds (milliseconds)
PAGE_LOAD_THRESHOLD=5000
INTERACTION_THRESHOLD=2000
API_CALL_THRESHOLD=1000

# Visual Regression Testing
UPDATE_SNAPSHOTS=false
VISUAL_THRESHOLD=0.2